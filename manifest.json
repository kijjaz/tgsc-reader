{
  "manifest_version": 3,
  "name": "TGSC Perfumery Companion",
  "version": "1.0.0",
  "description": "Perfumery student companion and live crawler for The Good Scents Company with student organ tiers, scent blending palettes, and formula scaling.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.thegoodscentscompany.com/*",
    "*://thegoodscentscompany.com/*"
  ],
  "side_panel": {
    "default_path": "app/studio.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TGSC Perfumery Companion"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.thegoodscentscompany.com/*",
        "*://thegoodscentscompany.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/student_tiers.json",
        "data/tgsc_directory.json",
        "icons/*.png",
        "app/*"
      ],
      "matches": [
        "*://*.thegoodscentscompany.com/*",
        "*://thegoodscentscompany.com/*"
      ]
    }
  ]
}
